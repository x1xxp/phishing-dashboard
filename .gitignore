# --- Python bytecode / build artefacts -------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version

# --- Environment / secrets --------------------------------------------------
.env
.env.*
*.env
secrets.toml
.streamlit/secrets.toml

# --- Logs and temporary files -----------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.swp
~$*

